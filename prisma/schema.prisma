generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ==================== USER & AUTH ====================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  role         UserRole  @default(USER)

  aiProvider  String @default("claude")
  aiModel     String @default("claude-sonnet-4-20250514")
  aiBaseUrl   String?
  aiApiKey    String?
  ttsProvider String @default("edge-tts")
  ttsVoice    String @default("zh-CN-YunxiNeural")

  projects  Project[]
  renderJobs RenderJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

// ==================== PROJECT ====================

model Project {
  id     String        @id @default(cuid())
  name   String
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       ProjectStatus @default(DRAFT)
  sourceText   String
  sourceType   SourceType    @default(TEXT)
  audioUploadUrl String?

  aspectRatio  AspectRatio  @default(W_16_9)
  contentStyle ContentStyle @default(KNOWLEDGE)
  colorTheme   String?

  aiAnalysis     String?
  productionPlan String?

  // Structured material requirements from user input
  // JSON: { contentSummary, referenceStyle, requiredSources[], preferredSources[], materialTypes[],
  //         properNouns[], landmarkScenes[], stylePreference, timeLimit, regionLimit, avoidKeywords[] }
  materialRequirements String?

  // Render mode: "stock" = 搜索影视素材, "ai_video" = AI生成视频
  renderMode String @default("stock")

  storyboard  Storyboard?
  messages    ChatMessage[]
  materials   Material[]
  segments    VideoSegment[]
  musicTracks MusicTrack[]
  renderJobs  RenderJob[]
  exportJobs  ExportJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([updatedAt])
}

enum ProjectStatus {
  DRAFT
  ANALYZING
  STORYBOARD_GENERATING
  STORYBOARD_READY
  PRODUCING
  EDITING
  RENDERING
  COMPLETED
  FAILED
}

enum SourceType {
  TEXT
  VOICE_UPLOAD
}

enum AspectRatio {
  W_16_9
  W_9_16
  W_1_1
}

enum ContentStyle {
  KNOWLEDGE
  CULTURE
  CLASSIC_HISTORY
  CUSTOM
}

// ==================== CHAT MESSAGES ====================

model ChatMessage {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role        ChatRole
  content     String
  messageType MessageType @default(TEXT)
  metadata    String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageType {
  TEXT
  ANALYSIS
  PLAN_SELECTION
  STORYBOARD_CARD
  GENERATION_STATUS
  REQUIREMENTS_DOC
  SKELETON_PLAN
  STORYBOARD_BOOK
}

// ==================== STORYBOARD ====================

model Storyboard {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title          String?
  totalScenes    Int     @default(0)
  totalDuration  Float?
  totalWords     Int?

  status StoryboardStatus @default(GENERATING)
  scenes Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StoryboardStatus {
  GENERATING
  READY
  EDITED
  CONFIRMED
}

model Scene {
  id           String     @id @default(cuid())
  storyboardId String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  sceneNumber   Int
  title         String?
  sceneType     SceneType @default(REAL_FOOTAGE)
  voiceoverText String
  visualDesc    String
  materialQuery String
  subtitleText  String?

  productionMeta String? // JSON: { scripts[], properNouns[], era, sources[], preference }

  wordCount          Int?
  estimatedDuration  Float?

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  audioUrl      String?
  audioDuration Float?
  thumbnailUrl  String?
  renderedUrl   String?

  // Non-fatal issues encountered during render (e.g. TTS fell back to silence)
  renderWarning String?

  transition TransitionType @default(CROSS_DISSOLVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyboardId, sceneNumber])
}

enum SceneType {
  REAL_FOOTAGE
  ANIMATION
  AI_GENERATED
  CUSTOM
}

enum TransitionType {
  CUT
  CROSS_DISSOLVE
  FADE_BLACK
  WIPE
}

// ==================== MATERIALS ====================

model Material {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  name   String
  type   MaterialType
  source MaterialSource

  fileUrl      String
  thumbnailUrl String?
  previewUrl   String?

  width    Int?
  height   Int?
  duration Float?
  fileSize Int?
  format   String?

  externalId    String?
  externalSource String?

  aiPrompt  String?
  aiProvider String?

  license      String?
  attribution  String?

  searchQuery String?
  matchScore  Float?

  scenes Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([externalId])
}

enum MaterialType {
  VIDEO
  IMAGE
  AUDIO
  ANIMATION
}

enum MaterialSource {
  STOCK_FOOTAGE
  AI_GENERATED
  USER_UPLOADED
  TEMPLATE
}

// ==================== RENDER JOBS ====================

model RenderJob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  status   RenderStatus @default(QUEUED)
  priority Int          @default(0)

  currentStage  String?
  progress      Float  @default(0)
  stageProgress String?

  config String

  outputUrl      String?
  outputFormat   String?
  outputSize     Int?
  outputDuration Float?

  errorMessage String?
  errorStage   String?
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)

  startedAt         DateTime?
  completedAt       DateTime?
  estimatedDuration Float?
  elapsedSeconds    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([projectId])
  @@index([status, priority, createdAt])
}

enum RenderStatus {
  QUEUED
  PREPARING
  TTS_GENERATING
  MATERIALS_LOADING
  COMPOSITING
  SUBTITLING
  POST_PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum RenderStage {
  TTS
  MATERIALS
  COMPOSE
  SUBTITLES
  AUDIO_MIX
  ENCODE
  THUMBNAILS
}

// ==================== EXPORT JOBS ====================

model ExportJob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  format ExportFormat @default(MP4_1080P)
  status ExportStatus @default(PENDING)

  outputUrl String?
  fileSize  Int?

  createdAt   DateTime @default(now())
  completedAt DateTime?
}

enum ExportFormat {
  MP4_1080P
  MP4_720P
  MP4_4K
  MOV_PRORES
  GIF
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==================== VIDEO SEGMENTS ====================

model VideoSegment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  fileUrl   String
  thumbnailUrl String?

  duration  Float
  width     Int?
  height    Int?
  fileSize  Int?
  format    String? @default("mp4")

  trimStart Float?
  trimEnd   Float?

  sortOrder Int @default(0)
  sceneId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, sortOrder])
}

// ==================== MUSIC TRACKS ====================

model MusicTrack {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  fileUrl   String
  duration  Float
  volume    Float   @default(0.3)

  mood      String?
  genre     String?
  bpm       Int?

  isBgm     Boolean @default(true)
  fadeIn    Float   @default(1.0)
  fadeOut   Float   @default(2.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ==================== AI CACHE ====================

model AICache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  operation String
  result    String
  createdAt DateTime @default(now())

  @@index([cacheKey])
  @@index([operation, createdAt])
  @@index([createdAt])
}

// ==================== RENDER TASK QUEUE ====================
// DB-backed async job queue — no Redis/BullMQ dependency.
// Workers atomically claim PENDING tasks and process them inline.
// Stale PROCESSING tasks (>30 min) are auto-reset on startup.

model RenderTask {
  id        String      @id @default(cuid())
  projectId String
  userId    String

  status    TaskStatus  @default(PENDING)
  priority  Int         @default(0)

  // The RenderJob this task created (optional — set after job creation)
  renderJobId String?

  config    String?     // JSON snapshot of render config
  errorMessage String?

  claimedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, priority, createdAt])
  @@index([projectId])
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
